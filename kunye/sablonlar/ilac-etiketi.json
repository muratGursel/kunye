{
  "id": "ilac-etiketi",
  "name": "İlaç / Serum Etiketi",
  "description": "100 x 60 mm hazırlanan ilaç ve infüzyon etiketi. Yalnızca girilen bilgiyi basar, hesaplama yapmaz.",
  "width_mm": 100,
  "height_mm": 60,
  "rotate": 0,
  "fields": [
    {"key": "ad_soyad", "label": "Ad Soyad", "required": true, "example": "Şükrü Işık Gündoğdu"},
    {"key": "protokol_no", "label": "Protokol No", "required": true, "example": "2026104512"},
    {"key": "ilac", "label": "İlaç", "required": true, "example": "Seftriakson 1 g"},
    {"key": "doz", "label": "Doz", "required": true, "example": "1 g IV 12 saatte bir"},
    {"key": "seyreltici", "label": "Seyreltici", "example": "100 ml %0,9 NaCl"},
    {"key": "hiz", "label": "İnfüzyon Hızı", "example": "30 dakikada"},
    {"key": "yatak", "label": "Yatak", "example": "214-B"},
    {"key": "hazirlayan", "label": "Hazırlayan", "required": true, "example": "Hmş. Elif Çağlar"}
  ],
  "elements": [
    {"type": "text", "x_mm": 50, "y_mm": 2, "height_mm": 4, "bold": true, "align": "center", "text": "İLAÇ / SERUM ETİKETİ"},
    {"type": "line", "x1_mm": 2, "y1_mm": 7.5, "x2_mm": 98, "y2_mm": 7.5, "thickness_mm": 0.4},
    {"type": "text", "x_mm": 3, "y_mm": 9, "height_mm": 3.6, "bold": true, "max_width_mm": 94, "text": "{ad_soyad|buyuk}"},
    {"type": "text", "x_mm": 3, "y_mm": 14, "height_mm": 3, "max_width_mm": 94, "text": "Prot: {protokol_no}   Yatak: {yatak}"},
    {"type": "text", "x_mm": 3, "y_mm": 20, "height_mm": 3.6, "bold": true, "max_width_mm": 94, "text": "İlaç: {ilac}"},
    {"type": "text", "x_mm": 3, "y_mm": 25.5, "height_mm": 3.2, "max_width_mm": 94, "text": "Doz: {doz}"},
    {"type": "text", "x_mm": 3, "y_mm": 30.5, "height_mm": 3.2, "max_width_mm": 94, "text": "Seyreltici: {seyreltici}", "show_if": "seyreltici"},
    {"type": "text", "x_mm": 3, "y_mm": 35.5, "height_mm": 3.2, "max_width_mm": 94, "text": "Hız: {hiz}", "show_if": "hiz"},
    {"type": "line", "x1_mm": 2, "y1_mm": 41, "x2_mm": 98, "y2_mm": 41, "thickness_mm": 0.3},
    {"type": "text", "x_mm": 3, "y_mm": 43, "height_mm": 3, "max_width_mm": 66, "text": "Hazırlayan: {hazirlayan}"},
    {"type": "text", "x_mm": 3, "y_mm": 48, "height_mm": 3, "text": "Tarih: {bugun} {saat}"},
    {"type": "text", "x_mm": 3, "y_mm": 53.5, "height_mm": 3, "text": "Uygulayan: ____________"},
    {"type": "barcode", "x_mm": 72, "y_mm": 43, "height_mm": 10, "module_mm": 0.25, "human_readable": true, "data": "{protokol_no}"}
  ]
}
